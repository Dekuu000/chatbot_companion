// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// User model for demo login or mock user
model User {
  id            String       @id @default(cuid())
  username      String       @unique
  email         String?      @unique
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  
  // Relations
  profile       Profile?
  conversations Conversation[]
  resumes       Resume[]
  careerSuggestions CareerSuggestion[]
  feedbacks     Feedback[]
  
  @@map("users")
}

// User profile with skills, interests, education level
model Profile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Profile fields
  skills        String   @default("[]") // JSON array of skills
  interests     String   @default("[]") // JSON array of interests
  educationLevel String? // e.g., "High School", "Bachelor's", "Master's", "PhD"
  major         String?
  currentYear   String?  // e.g., "Freshman", "Sophomore", "Junior", "Senior", "Graduate"
  goals         String?  // Career goals description
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@map("profiles")
}

// Career suggestions generated by AI
model CareerSuggestion {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Career details
  title         String
  skillsRequired String  // JSON array or comma-separated
  summary       String   @db.Text
  salaryGuideline String? // Salary range or guideline
  nextSteps     String?  @db.Text // Recommended next steps
  
  // AI metadata
  confidenceScore Float? // 0-1 confidence score
  verificationPlan String? @db.Text // How to verify key facts
  
  createdAt     DateTime @default(now())
  
  @@map("career_suggestions")
  @@index([userId])
}

// Conversation metadata (chat history stored client-side, only metadata here)
model Conversation {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title         String?  // Optional conversation title
  messageCount  Int      @default(0)
  lastMessageAt DateTime @default(now())
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@map("conversations")
  @@index([userId])
}

// Resume storage with BLOB for real PDF resumes
model Resume {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  fileName      String
  fileData      Bytes    // BLOB storage for real PDF resumes
  fileSize      Int      // Size in bytes
  mimeType      String   @default("application/pdf")
  
  // Extracted text content
  extractedText String?  @db.Text
  
  // Analysis results
  analysisResult String? @db.Text // JSON string with AI analysis
  careerAlignment String? @db.Text // JSON string with career match results
  improvementSuggestions String? @db.Text // JSON string with suggestions
  overallScore   Float? // 0-100 overall score
  
  createdAt     DateTime @default(now())
  
  @@map("resumes")
  @@index([userId])
}

// Feedback model for storing various types of feedback
model Feedback {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type          String   // e.g., "resume", "interview", "career"
  content       String   @db.Text
  metadata      String?  @db.Text // JSON string for additional data
  
  createdAt     DateTime @default(now())
  
  @@map("feedbacks")
  @@index([userId])
}

// Audit log for tracking important actions (minimal logs per requirements)
model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  
  action        String   // e.g., "chat_message", "career_suggestion", "resume_upload"
  entityType    String?  // e.g., "conversation", "resume", "career"
  entityId      String?
  metadata      String?  @db.Text // JSON string for minimal logs
  
  createdAt     DateTime @default(now())
  
  @@map("audit_logs")
  @@index([userId])
  @@index([createdAt])
}

# Environment Variables Configuration
# 
# Setup Instructions:
# 1. Copy this file to .env: cp env.example .env (Linux/Mac) or Copy-Item env.example .env (Windows)
# 2. Replace all placeholder values (YOUR_PASSWORD, YOUR_HOST, etc.) with your actual credentials
# 3. Never commit .env to version control - it contains sensitive information
#
# For detailed setup guide, see README.md

# Database
# Aiven MySQL (recommended for production/cloud hosting)
# Format: mysql://username:password@host:port/database?sslaccept=strict
# Get credentials from: Aiven Console → Your MySQL Service → Overview → Connection information
# Important: Always include ?sslaccept=strict for SSL connection
DATABASE_URL="mysql://avnadmin:YOUR_PASSWORD@YOUR_HOST:PORT/defaultdb?ssl-mode=REQUIRED"

# Local MySQL (for development - optional)
# DATABASE_URL="mysql://root:@localhost:3306/dbname"

# Perplexity API Key (preferred)
PERPLEXITY_API_KEY="your-perplexity-api-key-here"
# Optional: Override model (default is "sonar")
# Available: sonar, sonar-pro, sonar-reasoning, sonar-reasoning-pro, sonar-deep-research
# PERPLEXITY_MODEL="sonar"
# Optional: shorten resume analysis wait (milliseconds, default 45000)
# RESUME_ANALYSIS_TIMEOUT_MS=20000

# Gemini API Key (backup/fallback when Perplexity fails or runs out of credits)
# Get your API key from: https://makersuite.google.com/app/apikey
# This will be used automatically if Perplexity API fails (e.g., credit exhaustion, rate limits, errors)
GEMINI_API_KEY="your-gemini-api-key-here"
# Optional: Override Gemini model (default is "gemini-flash-latest")
# Available models: gemini-flash-latest, gemini-2.5-flash, gemini-2.5-pro, gemini-pro-latest
# Run "node scripts/list-gemini-models.js" to see all available models
# GEMINI_MODEL="gemini-flash-latest"

# Optional: override the advisor persona prompt (paste multi-line content using \n escapes if needed)
SYSTEM_PROMPT=""
# Optional: override concise factual-response prompt
SYSTEM_PROMPT_DIRECT=""

# OpenAI API Key (optional fallback)
#OPENAI_API_KEY=""

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth (Google via Auth.js)
# Generate NEXTAUTH_SECRET: openssl rand -base64 32 (or use online generator)
NEXTAUTH_SECRET="replace-with-strong-random-secret"
AUTH_GOOGLE_ENABLED="false"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED="false"
